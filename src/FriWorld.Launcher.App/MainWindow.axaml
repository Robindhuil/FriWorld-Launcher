<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FriWorld.Launcher.App.ViewModels"
        mc:Ignorable="d"
        x:Class="FriWorld.Launcher.App.MainWindow"
        x:DataType="vm:LauncherViewModel"
        Title="FriWorld"
        Icon="/Assets/icon.png"
        Width="980" Height="720"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Without a system frame there is no system shortcut either, so the two keys everyone
         expects have to be wired by hand. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding DismissCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FBB800" />
        <SolidColorBrush x:Key="OnAccent" Color="#1A1400" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EBFFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#BDFFFFFF" />
        <SolidColorBrush x:Key="TextTertiary" Color="#9EFFFFFF" />
        <SolidColorBrush x:Key="TextMuted" Color="#7AFFFFFF" />
        <SolidColorBrush x:Key="Hairline" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="OutlineIdle" Color="#42FFFFFF" />
        <SolidColorBrush x:Key="HoverFill" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="TrackFill" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="DisabledFill" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="DisabledText" Color="#6BFFFFFF" />
    </Window.Resources>

    <Window.Styles>
        <!-- The window chrome buttons: minimise, and close with its red hover. -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#590A0B10" />
            <Setter Property="Foreground" Value="#B8FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#29FFFFFF" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0392B" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- The one prominent button. Carries the trademark colour; nothing else in the
             window may, so that what to press is never in question. -->
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="52" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="34,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFC626" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OnAccent}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DisabledFill}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource DisabledText}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DBFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineIdle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverFill}" />
            <Setter Property="BorderBrush" Value="#6BFFFFFF" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{StaticResource DisabledText}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        </Style>

        <!-- Removing the game sits next to playing it, so it must not look like a peer of the
             primary. Same outline as any other secondary until the pointer lands, then red. -->
        <Style Selector="Button.secondary.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D3C0E0C" />
            <Setter Property="BorderBrush" Value="#6BF0786E" />
            <Setter Property="TextElement.Foreground" Value="#FFB4AC" />
        </Style>

        <!-- Square icon buttons in the action bar. Same height as the rest so the row reads as one
             line, but no text: these two are recognised rather than read. -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource OutlineIdle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverFill}" />
            <Setter Property="BorderBrush" Value="#6BFFFFFF" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Foreground" Value="#C4FFFFFF" />
        </Style>
        <Style Selector="Button.icon:pointerover PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.icon:disabled PathIcon">
            <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
        </Style>

        <!-- Deliberately quieter than the primary: a newer launcher is a note, not the task. -->
        <Style Selector="Button.ghost">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DBFFFFFF" />
            <Setter Property="BorderBrush" Value="#47FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverFill}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ADFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverFill}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- Rows inside the overflow menu. Rare actions belong here rather than in the action
             bar, where a fourth button would blunt the one that matters. -->
        <Style Selector="Button.menuitem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DBFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverFill}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D3C0E0C" />
            <Setter Property="TextElement.Foreground" Value="#FFB4AC" />
        </Style>

        <!-- Keyboard focus has to be visible on a photographic background, and the theme's dashed
             adorner is not. Only :focus-visible, so a ring never appears after a mouse click. -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="ProgressBar.slim">
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource TrackFill}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <!-- Rounded outer edge. The window itself is transparent so the corners are real. -->
    <Border CornerRadius="10" ClipToBounds="True" Background="#0B0C11">
        <Panel>

            <!-- Layer 1: the render. Slightly desaturated and darkened so it stays a
                 backdrop rather than competing with the text. -->
            <Image Source="/Assets/fri-render.png"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <!-- Layer 2: the scrim. Bright sky at the top and dark paving at the bottom
                 would otherwise swing text contrast wildly across the window. -->
            <Panel>
                <Panel.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.00" Color="#CC08090E" />
                        <GradientStop Offset="0.26" Color="#5208090E" />
                        <GradientStop Offset="0.44" Color="#4708090E" />
                        <GradientStop Offset="0.72" Color="#DB06070B" />
                        <GradientStop Offset="1.00" Color="#F7050609" />
                    </LinearGradientBrush>
                </Panel.Background>
            </Panel>

            <!-- Hairline inside the rounded edge. -->
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#1AFFFFFF" />

            <!-- Layer 3: content. -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="44,38,44,0">

                <!-- Header -->
                <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                    <!-- Actions on the launcher itself, as opposed to actions on the game. Those
                         live in the action bar where the hand already is; these are asked for
                         about once in the life of an install. -->
                    <Button Grid.Row="0" Grid.Column="0"
                            Classes="chrome"
                            Content="&#x22EF;"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            ToolTip.Tip="Akcie launchera">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="250" Spacing="2">
                                    <Button Classes="menuitem"
                                            Content="Skontrolovať znova"
                                            Command="{Binding RecheckCommand}" />
                                    <Button Classes="menuitem"
                                            Content="Otvoriť denník launchera"
                                            Command="{Binding OpenLogCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12" Margin="0,20,0,0">
                        <!-- Placeholder for the logo artwork: two-tone wordmark until the
                             image lands, then this becomes an Image. -->
                        <StackPanel Orientation="Horizontal" x:Name="Logo">
                            <TextBlock Text="Fri"
                                       FontSize="60"
                                       FontWeight="Bold"
                                       LineHeight="60"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock Text="World"
                                       FontSize="60"
                                       FontWeight="Bold"
                                       LineHeight="60"
                                       Foreground="White" />
                        </StackPanel>

                        <!-- Fixed height so an empty version line does not move the logo. -->
                        <TextBlock Text="{Binding VersionLine}"
                                   Height="38"
                                   MaxWidth="780"
                                   HorizontalAlignment="Left"
                                   FontSize="28"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Top">
                        <Button Classes="chrome"
                                Content="&#x2014;"
                                IsVisible="{Binding ShowMinimise}"
                                Command="{Binding MinimiseCommand}"
                                ToolTip.Tip="Minimalizovať" />
                        <Button Classes="chrome close"
                                Content="&#x2715;"
                                Command="{Binding CloseCommand}"
                                ToolTip.Tip="Zavrieť"
                                AutomationProperties.Name="Zavrieť" />
                    </StackPanel>

                </Grid>

                <!-- Middle. Bottom-aligned so progress and errors grow upward and the
                     action bar never shifts under the pointer. -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,26,0,0">

                    <!-- A newer launcher. Independent of the state below it. -->
                    <Border Grid.Row="0"
                            IsVisible="{Binding LauncherUpdateAvailable}"
                            MaxWidth="660"
                            HorizontalAlignment="Left"
                            CornerRadius="8"
                            Padding="18,14,16,14"
                            Background="#990A0B10"
                            BorderThickness="1"
                            BorderBrush="#29FFFFFF">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LauncherUpdateTitle}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding LauncherUpdateNote}"
                                           IsVisible="{Binding HasLauncherUpdateNote}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextTertiary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Content="{Binding LauncherUpdateAction}"
                                    VerticalAlignment="Center"
                                    Command="{Binding UpdateLauncherCommand}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" VerticalAlignment="Bottom" MaxWidth="660"
                          HorizontalAlignment="Left" Margin="0,20,0,0">

                        <!-- Release notes -->
                        <StackPanel Spacing="10" IsVisible="{Binding NotesVisible}">
                            <TextBlock Text="ČO JE NOVÉ"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding Notes}"
                                       FontSize="15" LineHeight="24"
                                       MaxLines="3"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding Detail}"
                                       IsVisible="{Binding InfoVisible}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiary}" />
                        </StackPanel>

                        <!-- Plain sentence, for states with nothing else to show. -->
                        <TextBlock Text="{Binding Detail}"
                                   IsVisible="{Binding PlainTextVisible}"
                                   MaxWidth="520"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   FontSize="15" LineHeight="24"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" />

                        <!-- Failure. The word "CHYBA" carries the meaning, not the colour —
                             colour alone excludes anyone who cannot see the difference. -->
                        <Border IsVisible="{Binding FailureVisible}"
                                CornerRadius="8"
                                Padding="18,16"
                                Background="#9E3C0E0C"
                                BorderThickness="1"
                                BorderBrush="#6BF0786E">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Text="CHYBA"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#FF9A90"
                                           VerticalAlignment="Top"
                                           Margin="0,3,0,0" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="{Binding FailureHeadline}"
                                               FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="#FFD9D4" />
                                    <TextBlock Text="{Binding FailureAdvice}"
                                               IsVisible="{Binding HasFailureAdvice}"
                                               FontSize="14" LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- The uninstall question. In the window rather than a dialog,
                             because everything else this launcher says is here too. The
                             destructive answer stays the quiet one. -->
                        <Border IsVisible="{Binding ConfirmingUninstall}"
                                CornerRadius="8"
                                Padding="18,16"
                                Background="#9E1A1206"
                                BorderThickness="1"
                                BorderBrush="#5CFBB800">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Odinštalovať hru?"
                                               FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Stiahnuté súbory hry sa vymažú. Vrátiť sa to nedá, ale hru sa dá kedykoľvek nainštalovať znova."
                                               FontSize="14" LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="ghost"
                                            Content="Odinštalovať"
                                            Command="{Binding ConfirmUninstallCommand}" />
                                    <Button Classes="link"
                                            Content="Ponechať"
                                            Command="{Binding CancelUninstallCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Closing. Not destructive — a partial download is kept — but the
                             launcher is one window with one job, and neither a stray click on the
                             corner nor a reflex on Escape should end it. -->
                        <Border IsVisible="{Binding ConfirmingClose}"
                                CornerRadius="8"
                                Padding="18,16"
                                Background="#9E0A0B10"
                                BorderThickness="1"
                                BorderBrush="#42FFFFFF">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Zavrieť launcher?"
                                               FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding CloseQuestionDetail}"
                                               FontSize="14" LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="ghost"
                                            Content="Zavrieť"
                                            Command="{Binding ConfirmCloseCommand}" />
                                    <Button Classes="link"
                                            Content="Späť"
                                            Command="{Binding CancelCloseCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Progress. One process with a changing phase name, not four screens. -->
                        <StackPanel Spacing="10" MaxWidth="600" HorizontalAlignment="Left"
                                    IsVisible="{Binding ProgressVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PhaseName}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PercentText}"
                                           IsVisible="{Binding HasPercent}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" />
                            </Grid>
                            <ProgressBar Classes="slim"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding Progress}"
                                         IsIndeterminate="{Binding ProgressIndeterminate}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Detail}"
                                           FontSize="13.5"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextTertiary}" />
                                <Button Grid.Column="1"
                                        Classes="link"
                                        Content="Zrušiť"
                                        IsVisible="{Binding CanCancel}"
                                        Command="{Binding CancelCommand}" />
                            </Grid>
                        </StackPanel>

                    </Grid>
                </Grid>

                <!-- Action bar -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Hairline}"
                        Margin="0,22,0,0" Padding="0,22,0,30">
                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDot}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}"
                                       FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>

                        <!-- Widest on the right, each one quieter towards the left. The three on
                             the left act on a game already on disk, so they are not here at all
                             until there is one. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Button Classes="icon"
                                    IsVisible="{Binding IsInstalled}"
                                    Command="{Binding RepairCommand}"
                                    ToolTip.Tip="Opraviť inštaláciu"
                                    AutomationProperties.Name="Opraviť inštaláciu">
                                <PathIcon Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
                            </Button>
                            <Button Classes="icon"
                                    IsVisible="{Binding IsInstalled}"
                                    Command="{Binding RevealCommand}"
                                    ToolTip.Tip="Otvoriť priečinok s hrou"
                                    AutomationProperties.Name="Otvoriť priečinok s hrou">
                                <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                            </Button>
                            <Button Classes="secondary danger"
                                    Content="Odinštalovať"
                                    Padding="18,0"
                                    FontSize="14"
                                    IsVisible="{Binding IsInstalled}"
                                    Command="{Binding AskUninstallCommand}" />
                            <Button Classes="secondary"
                                    Content="{Binding SecondaryLabel}"
                                    IsVisible="{Binding SecondaryVisible}"
                                    Command="{Binding SecondaryCommand}" />
                            <!-- IsDefault, not a window-wide Enter binding: a button that has the
                                 focus must be the one Enter presses. This only catches Enter that
                                 nothing else wanted. -->
                            <Button Classes="primary"
                                    Content="{Binding PrimaryLabel}"
                                    IsDefault="True"
                                    IsEnabled="{Binding PrimaryEnabled}"
                                    Command="{Binding PrimaryCommand}" />
                        </StackPanel>

                    </Grid>
                </Border>

            </Grid>
        </Panel>
    </Border>

</Window>
