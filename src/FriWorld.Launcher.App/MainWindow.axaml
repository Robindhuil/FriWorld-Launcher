<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FriWorld.Launcher.App.ViewModels"
        mc:Ignorable="d"
        x:Class="FriWorld.Launcher.App.MainWindow"
        x:DataType="vm:LauncherViewModel"
        Title="FriWorld"
        Width="560" Height="380"
        MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="28">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionLine}" Opacity="0.6" FontSize="13" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12">

            <TextBlock Text="{Binding Notes}"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       MaxLines="3"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Spacing="6" IsVisible="{Binding ProgressVisible}">
                <ProgressBar Minimum="0" Maximum="100"
                             Height="6"
                             Value="{Binding Progress}"
                             IsIndeterminate="{Binding ProgressIndeterminate}" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Detail}" FontSize="12" Opacity="0.6" />
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Padding="10,2"
                            FontSize="12"
                            IsVisible="{Binding CanCancel}"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </StackPanel>

            <!-- Neutral detail: the download size before installing, the reassurance beside an
                 offered update, the note left after a cancelled download. -->
            <TextBlock Text="{Binding Detail}"
                       IsVisible="{Binding InfoVisible}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.7" />

            <!-- Failure detail and advice. Kept separate from the status line so the headline
                 stays short enough to read at a glance. -->
            <StackPanel Spacing="4" IsVisible="{Binding Failed}">
                <TextBlock Text="{Binding Detail}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#d9534f" />
                <TextBlock Text="{Binding FailureAdvice}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Opacity="0.7" />
            </StackPanel>

            <!-- A newer launcher. Installed in place when the manifest carries a binary for this
                 machine, otherwise offered as a link. -->
            <Border IsVisible="{Binding LauncherUpdateAvailable}"
                    Background="#14808080"
                    CornerRadius="6"
                    Padding="12,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               Text="{Binding LauncherUpdateNotice}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Opacity="0.8" />
                    <Button Grid.Column="1"
                            Content="{Binding LauncherUpdateAction}"
                            Padding="12,5"
                            FontSize="12"
                            Command="{Binding UpdateLauncherCommand}" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- One prominent button whose meaning follows the state — Install, Update, Play or Retry —
             with a quieter one beside it for the alternative that makes sense at the time. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

            <TextBlock Grid.Column="0"
                       Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Opacity="0.85" />

            <Button Grid.Column="1"
                    Content="{Binding SecondaryLabel}"
                    Padding="14,10"
                    IsVisible="{Binding SecondaryVisible}"
                    Command="{Binding SecondaryCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding PrimaryLabel}"
                    MinWidth="128"
                    Padding="18,10"
                    FontWeight="SemiBold"
                    IsEnabled="{Binding PrimaryEnabled}"
                    Command="{Binding PrimaryCommand}" />

        </Grid>

    </Grid>

</Window>
