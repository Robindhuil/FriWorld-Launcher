<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      Not the project name, for the same reason Core carries one: Smart App Control judges unsigned
      assemblies by name, and once it decides against one every rebuild under that name fails to
      load. It did that to FriWorldLauncher.dll, then FriWorld.Launcher.Core.dll, then this. The
      whole suite goes down with it, so the name is a thing that gets changed, not defended.
      InternalsVisibleTo in Core has to match whatever this says.
    -->
    <AssemblyName>FriWorldLauncherSuite</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FriWorld.Launcher.Core\FriWorld.Launcher.Core.csproj" />
  </ItemGroup>

</Project>